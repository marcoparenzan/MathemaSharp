@page "/"
@rendermode InteractiveServer
@using MathemaSharp.Docs
@inject Documentation Docs
@inject IJSRuntime JS

<PageTitle>@title — MàthemaNet</PageTitle>
<a href="#main" class="skip-link">Vai al documento</a>
<div class="min-h-screen bg-slate-50 text-slate-900">
    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white px-6 py-4 flex items-center justify-between gap-4">
        <a href="/" class="font-bold text-2xl tracking-tight">MàthemaNet<span class="text-indigo-600"> / docs</span></a>
        <button class="rounded-lg bg-slate-900 text-white px-4 py-2" @onclick="Print">Stampa / PDF</button>
    </header>
    <div class="grid lg:grid-cols-[320px_1fr] max-w-[1600px] mx-auto">
        <aside class="border-r border-slate-200 bg-white p-5 lg:sticky lg:top-20 lg:h-[calc(100vh-80px)] overflow-auto" aria-label="Navigazione documentazione">
            <label for="search" class="text-xs uppercase tracking-widest font-bold text-slate-500">Esplora il laboratorio</label>
            <input id="search" type="search" placeholder="Cerca titolo o percorso…" @bind="search" @bind:event="oninput" class="mt-3 mb-5 w-full rounded-lg border border-slate-300 px-3 py-2" />
            <p class="text-xs text-slate-500 mb-4">@Filtered.Count() documenti</p>
            @foreach (var group in Filtered.GroupBy(d => d.Path.Contains('/') ? d.Path[..d.Path.LastIndexOf('/')] : "Panoramica"))
            {
                <details open class="mb-3">
                    <summary class="cursor-pointer text-xs font-bold text-indigo-700 py-2 break-words">@group.Key</summary>
                    @foreach (var entry in group)
                    {
                        <a href="@("/?doc=" + Uri.EscapeDataString(entry.Path))" aria-current="@(entry.Path == Current ? "page" : null)" class="block rounded-lg px-3 py-2 text-sm hover:bg-indigo-50 @(entry.Path == Current ? "bg-indigo-100 font-semibold" : "")">@entry.Title</a>
                    }
                </details>
            }
        </aside>
        <main id="main" class="min-w-0 px-6 py-10 lg:px-12">
            <div class="text-xs uppercase tracking-widest text-indigo-600 font-semibold mb-4 break-all">@Current</div>
            @if (html is null)
            {
                <h1 class="text-3xl font-bold">Documento non disponibile</h1>
                <p class="mt-4">Il percorso non esiste oppure non è consentito. Seleziona un documento dal menu.</p>
            }
            else
            {
                <article class="markdown bg-white rounded-2xl border border-slate-200 p-6 lg:p-10 shadow-sm">@((MarkupString)html)</article>
            }
        </main>
    </div>
</div>
@code {
    [SupplyParameterFromQuery(Name = "doc")] public string? DocumentPath { get; set; }
    private IReadOnlyList<DocumentEntry> entries = [];
    private string search = "";
    private string? html;
    private string title = "Documentazione";
    private string Current => DocumentPath ?? "README.md";
    private IEnumerable<DocumentEntry> Filtered => entries.Where(d => d.Title.Contains(search, StringComparison.OrdinalIgnoreCase) || d.Path.Contains(search, StringComparison.OrdinalIgnoreCase));
    protected override void OnInitialized() => entries = Docs.List();
    protected override void OnParametersSet()
    {
        html = Docs.Render(Current);
        title = entries.FirstOrDefault(d => d.Path == Current)?.Title ?? "Documentazione";
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("numbersDocs.enhance"); }
        catch (JSDisconnectedException) { /* The browser circuit has closed. */ }
    }
    private async Task Print()
    {
        try { await JS.InvokeVoidAsync("numbersDocs.print"); }
        catch (JSDisconnectedException) { /* The browser circuit has closed. */ }
    }
}
