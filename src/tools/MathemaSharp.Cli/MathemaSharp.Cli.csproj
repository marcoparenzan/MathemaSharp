    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <ToolCommandName>mathema</ToolCommandName>
    <PackageId>MathemaSharp.Cli</PackageId>
    <Version>0.1.0-net11-preview.1</Version>
