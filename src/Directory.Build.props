<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Single output in <repo>/artifacts: stable paths for the notebooks' #r directives and for the packages. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)../artifacts</ArtifactsPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
    <!-- The libraries in src/libs are the NuGet packages of the MathemaSharp family. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/libs/'))">
    <IsPackable>true</IsPackable>
    <Version>0.2.0</Version>
    <Authors>Marco Parenzan</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>numerics;generic-math;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591: not all public members have an XML comment; the other warnings remain errors. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup Label="CentralBuildArtifacts">
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>D:\Dev\BuildArtifacts\MathemaSharp</ArtifactsPath>
    <PackageOutputPath>D:\Dev\NuGetLocalFeed</PackageOutputPath>
  </PropertyGroup>
</Project>