<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Bridge between NDSharp (ndarray with NumPy semantics) and the Numbers libraries: T[], T[,] and Complex&lt;double&gt;[] for every IEEE Generic Math format.</Description>
    <!-- NDSharp.dll next to the bridge in artifacts/bin: needed by the notebooks' #r directives. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>0.2.1-net11-preview.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../NDSharp/src/NDSharp/NDSharp.csproj" />
    <ProjectReference Include="../MathemaSharp.LinearAlgebra/MathemaSharp.LinearAlgebra.csproj" />
  </ItemGroup>
</Project>