<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Feed locale: NDSharp (da PySharp) e JupyterNet. -->
    <add key="local" value="D:\Dev\NuGetLocalFeed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="NDSharp" />
      <package pattern="NDSharp.*" />
      <package pattern="JupyterNet.*" />
      <package pattern="MathemaSharp.*" />
      <package pattern="PlotSharp" />
      <package pattern="PlotSharp.*" />
      <package pattern="JupyterSharp.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
